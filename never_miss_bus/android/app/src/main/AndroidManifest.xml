<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ── Never Miss Bus permissions ─────────────────────────────── -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Driver GPS while a trip is active -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Keeps trip tracking alive with the screen off (foreground service
         with a persistent notification; started only during an active trip) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Android 13+ notification permission (requested at runtime) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:label="SRBS International School"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <!-- Maps: OpenStreetMap via flutter_map — NO API key needed. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Channel used when FCM displays notifications while the app is
                 backgrounded or terminated. -->
            <meta-data
              android:name="com.google.firebase.messaging.default_notification_channel_id"
              android:value="nmb_alerts" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- 📱 Phone HOME SCREEN widget (Duolingo style) — long-press home
             screen → Widgets → Never Miss Bus → drag to add -->
        <receiver
            android:name=".NmbHomeWidget"
            android:exported="true"
            android:label="SRBS International School">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nmb_home_widget_info"/>
        </receiver>

        <!-- Foreground location service used by geolocator during trips -->
        <service
            android:name="com.baseflow.geolocator.GeolocatorLocationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location"/>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
