rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Authentication and role helpers ──────────────────────────────
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function signedIn() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && me().isActive == true;
    }

    function isAdmin() {
      return signedIn() && me().role == 'admin';
    }

    function isTeacher() {
      return signedIn() && me().role == 'teacher';
    }

    function isStudent() {
      return signedIn() && me().role == 'student';
    }

    function isDriver() {
      return signedIn() && me().role == 'driver';
    }

    function isStaff() {
      return isAdmin() || isTeacher();
    }

    function myBusId() {
      return me().busId;
    }

    // ── Users ─────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if request.auth != null
        && (
          request.auth.uid == uid
          || isAdmin()
          || (isStudent() && resource.data.role == 'teacher')
          || (isTeacher()
              && resource.data.role == 'student'
              && resource.data.classSection == me().classSection)
        );

      allow create: if (
          (isAdmin()
            && request.resource.data.role in
                ['student', 'driver', 'teacher', 'admin'])
          || (isTeacher()
              && request.resource.data.role == 'student'
              && request.resource.data.classSection == me().classSection
              && !request.resource.data.keys().hasAny(['fees']))
        )
        && request.resource.data.fullName is string
        && request.resource.data.email is string
        && request.resource.data.isActive == true;

      allow update: if (
          isAdmin()
          && (
            uid != request.auth.uid
            || (
              request.resource.data.role == resource.data.role
              && request.resource.data.isActive == true
            )
          )
        )
        || (
          isTeacher()
          && resource.data.role == 'student'
          && resource.data.classSection == me().classSection
          && request.resource.data.role == 'student'
          && request.resource.data.classSection == me().classSection
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'fullName', 'phone', 'contactEmail', 'photoB64',
                'fatherPhotoB64', 'motherPhotoB64', 'settings', 'updatedAt'
              ])
        )
        || (
          request.auth != null
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['fcmTokens', 'settings', 'lastSeenAt'])
        );

      allow delete: if isAdmin()
        || (
          isTeacher()
          && resource.data.role == 'student'
          && resource.data.classSection == me().classSection
        );

      match /inbox/{notifId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['read'])
          && request.resource.data.read == true;
        allow create: if isAdmin()
          && request.resource.data.title is string
          && request.resource.data.body is string;
        allow delete: if isAdmin();
      }
    }

    // ── Transport ────────────────────────────────────────────────────
    match /buses/{busId} {
      allow read: if isStaff()
        || ((isStudent() || isDriver()) && myBusId() == busId);
      allow create, update: if isAdmin()
        && request.resource.data.busNumber is string
        && request.resource.data.plateNumber is string;
      allow delete: if isAdmin();
    }

    match /routes/{routeId} {
      allow read: if isAdmin()
        || ((isStudent() || isDriver()) && resource.data.busId == myBusId());
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.busId is string;
      allow update: if isDriver()
        && resource.data.busId == myBusId()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['recordedPath']);
      allow create: if isDriver()
        && request.resource.data.busId == myBusId()
        && request.resource.data.isActive == true;
      allow delete: if isAdmin();
    }

    match /stops/{stopId} {
      allow read: if isStaff()
        || ((isStudent() || isDriver()) && resource.data.busId == myBusId());
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.location.lat is number
        && request.resource.data.location.lng is number
        && request.resource.data.location.lat >= -90.0
        && request.resource.data.location.lat <= 90.0
        && request.resource.data.location.lng >= -180.0
        && request.resource.data.location.lng <= 180.0;
      allow delete: if isAdmin();
    }

    match /trips/{tripId} {
      allow read: if isAdmin()
        || (isDriver() && resource.data.driverId == request.auth.uid)
        || (isStudent() && resource.data.busId == myBusId());
      allow create: if isDriver()
        && request.resource.data.driverId == request.auth.uid
        && request.resource.data.busId == myBusId()
        && request.resource.data.status == 'active'
        && request.resource.data.direction in ['pickup', 'drop'];
      allow update: if isAdmin()
        || (
          isDriver()
          && resource.data.driverId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'endedAt', 'lastKnown', 'stopsReached'])
          && request.resource.data.status in ['active', 'completed']
        );
      allow delete: if false;
    }

    // ── Audit and configuration ──────────────────────────────────────
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /config/school {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ── Attendance and applications ──────────────────────────────────
    match /attendance/{attId} {
      allow read: if isAdmin()
        || (isTeacher() && resource.data.classSection == me().classSection)
        || (isStudent() && resource.data.classSection == me().classSection);
      allow create: if isAdmin()
        || (
          isTeacher()
          && request.resource.data.classSection == me().classSection
          && request.resource.data.takenBy == request.auth.uid
          && request.resource.data.locked == true
        );
      allow update, delete: if isAdmin();
    }

    match /applications/{appId} {
      allow create: if isStudent()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.classSection == me().classSection;
      allow read: if isAdmin()
        || (isStudent() && resource.data.uid == request.auth.uid)
        || (isTeacher() && resource.data.classSection == me().classSection);
      allow update: if (
          isAdmin()
          || (isTeacher() && resource.data.classSection == me().classSection)
        )
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.decidedBy == request.auth.uid
        && (
          request.resource.data.status == 'approved'
          || (
            request.resource.data.decisionNote is string
            && request.resource.data.decisionNote.size() >= 3
          )
        )
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'decidedBy', 'decidedAt', 'decisionNote']);
      allow delete: if isAdmin();
    }

    // ── Error reports ─────────────────────────────────────────────────
    match /errorReports/{reportId} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin();
    }

    // ── Student documents metadata ───────────────────────────────────
    match /studentDocuments/{documentId} {
      allow read: if isAdmin()
        || (isStudent() && resource.data.studentUid == request.auth.uid);
      allow create: if isAdmin()
        && request.resource.data.studentUid is string
        && request.resource.data.label is string
        && request.resource.data.fileName is string
        && request.resource.data.contentType is string
        && request.resource.data.storageProvider in ['firebase', 'r2']
        && (
          (
            request.resource.data.storageProvider == 'firebase'
            && request.resource.data.downloadUrl is string
            && request.resource.data.storagePath is string
          )
          || (
            request.resource.data.storageProvider == 'r2'
            && request.resource.data.objectKey is string
          )
        );
      allow update, delete: if isAdmin();
    }

    // ── Exam results ──────────────────────────────────────────────────
    match /examResults/{resultId} {
      allow read: if isAdmin()
        || (isStudent() && resource.data.studentUid == request.auth.uid)
        || (isTeacher() && resource.data.classSection == me().classSection);
      allow create: if isAdmin()
        || (isTeacher() && request.resource.data.classSection == me().classSection);
      allow update, delete: if isAdmin();
    }

    // ── Timetable ─────────────────────────────────────────────────────
    match /timetable/{entryId} {
      allow read: if isAdmin()
        || (
          isStudent()
          && resource.data.entryType == 'class'
          && resource.data.classSection == me().classSection
        )
        || (
          isTeacher()
          && (
            resource.data.teacherUid == request.auth.uid
            || resource.data.classSection == me().classSection
          )
        );
      allow create: if isAdmin()
        && request.resource.data.entryType in ['class', 'lunchDuty']
        && request.resource.data.teacherUid is string
        && request.resource.data.teacher is string
        && request.resource.data.day is string;
      allow update, delete: if isAdmin();
    }

    // ── Notice board ──────────────────────────────────────────────────
    match /notices/{noticeId} {
      allow read: if isAdmin()
        || (
          isStudent()
          && (
            resource.data.targetClass == 'ALL'
            || resource.data.targetClass == me().classSection
          )
        )
        || (
          isTeacher()
          && (
            resource.data.targetClass == 'ALL'
            || resource.data.targetClass == me().classSection
          )
        );
      allow create, update, delete: if isAdmin();
    }

    // ── Library metadata ─────────────────────────────────────────────
    // PDF/audio files must stay on a licensed R2/CDN host.
    match /libraryBooks/{bookId} {
      allow read: if isAdmin()
        || ((isStudent() || isTeacher())
            && resource.data.isPublished == true);

      allow create: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.author is string
        && request.resource.data.category is string
        && request.resource.data.language is string
        && request.resource.data.description is string
        && request.resource.data.coverUrl is string
        && request.resource.data.pdfUrl is string
        && request.resource.data.audioUrl is string
        && request.resource.data.licenseType is string
        && request.resource.data.licenseUrl is string
        && request.resource.data.sourceUrl is string
        && request.resource.data.isPublished is bool
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.author is string
        && request.resource.data.category is string
        && request.resource.data.language is string
        && request.resource.data.isPublished is bool;

      allow delete: if isAdmin();
    }

    // ── Diary, homework and remarks ──────────────────────────────────
    match /diaries/{diaryId} {
      allow read: if isAdmin()
        || (isTeacher() && resource.data.classSection == me().classSection)
        || (isStudent() && resource.data.classSection == me().classSection);
      allow create, update: if isAdmin()
        || (
          isTeacher()
          && request.resource.data.teacherUid == request.auth.uid
          && request.resource.data.classSection == me().classSection
        );
      allow delete: if isAdmin();
    }

    match /homework/{homeworkId} {
      allow read: if isAdmin()
        || (isTeacher() && resource.data.classSection == me().classSection)
        || (isStudent() && resource.data.classSection == me().classSection);
      allow create: if isAdmin()
        || (
          isTeacher()
          && request.resource.data.teacherUid == request.auth.uid
          && request.resource.data.classSection == me().classSection
        );
      allow update, delete: if isAdmin()
        || (
          isTeacher()
          && resource.data.teacherUid == request.auth.uid
          && resource.data.classSection == me().classSection
        );
    }

    match /remarks/{remarkId} {
      allow read: if isAdmin()
        || (isStudent() && resource.data.studentUid == request.auth.uid)
        || (isTeacher() && resource.data.classSection == me().classSection);
      allow create: if isTeacher()
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.classSection == me().classSection
        && request.resource.data.category in
            ['Homework', 'Achievement', 'Class Test', 'Behaviour']
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 2
        && request.resource.data.text.size() <= 300;
      allow update, delete: if isAdmin();
    }

    // Everything not explicitly listed above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
